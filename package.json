{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "preview:worker": "npm run build && wrangler dev --local",
    "db:migrate:local": "wrangler d1 migrations apply classsync-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply classsync-db --remote",
    "db:backup": "tsx scripts/backup.mts",
    "deploy": "npm run build && wrangler deploy",
    "type-check": "tsc --noEmit",
    "test": "vitest run --testTimeout=30000 --hookTimeout=30000",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "generate:campuses": "tsx scripts/generate-campuses.ts",
    "build:stickers": "tsx scripts/build-stickers.ts",
    "prebuild": "tsx scripts/generate-campuses.ts && tsx scripts/build-stickers.ts",
    "attack": "tsx scripts/attack-suite.mts",
    "shots": "tsx scripts/shots.mts",
    "bootstrap:master": "tsx scripts/bootstrap-master.mts",
    "prelaunch-check": "tsx scripts/prelaunch-check.ts",
    "clean": "node scripts/clean.mjs",
    "lint": "tsc --noEmit",
    "pretest": "node scripts/check-node.mjs",
    "pretype-check": "node scripts/check-node.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "qrcode-generator": "2.0.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261012.1",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.14.0",
    "bwip-js": "^4.11.4",
    "esbuild": "^0.28.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "wrangler": "4.151.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
