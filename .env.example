# DialtoneApp / Cloudflare-Starter Configuration

# Base URL for the application (used for OAuth redirect callbacks)
APP_URL="http://localhost:3000"

# Google OAuth 2.0 Credentials (Authorization Code with PKCE)
# Obtain these from Google Cloud Console: Credentials -> OAuth 2.0 Client IDs -> Web application
# Authorized redirect URIs must include: ${APP_URL}/api/auth/callback
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
