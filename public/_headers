# Read by Cloudflare's static-assets layer now that only /api/* runs the Worker.
/stickers/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
# Vite names these files by content, so they can never change under the same name: no re-checking on every visit.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
# The on-device card reader (about 22 MB): downloaded once per phone, then kept for a month.
/ocr/*
  Cache-Control: public, max-age=2592000
/sw.js
  Cache-Control: no-cache
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self' blob: data:; worker-src 'self' blob:; frame-src https://challenges.cloudflare.com; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
